# Copy this file to .env and replace the values before running Docker Compose.
# Never commit .env or use these example values in production.
DB_NAME=industrial3d_db
DB_USER=industrial_user
DB_PASSWORD=replace-with-a-strong-local-password
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=./storage
